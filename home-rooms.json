---
layout: null
permalink: /home-rooms.json
---
[
{% for room_slug in site.data.room_order %}{% assign room = site.data.room_types[room_slug] %}
  {
    "slug": {{ room_slug | jsonify }},
    "enabled": {% if room.enabled == false %}false{% else %}true{% endif %},
    "name_vi": {{ room.name_vi | jsonify }},
    "name_en": {{ room.name_en | jsonify }},
    "room_count": {{ room.room_count | jsonify }},
    "guest_count": {{ room.guest_count | jsonify }},
    "size_m2": {{ room.size_m2 | jsonify }},
    "bed_vi": {{ room.bed_vi | jsonify }},
    "bed_en": {{ room.bed_en | jsonify }},
    "view_vi": {{ room.view_vi | jsonify }},
    "view_en": {{ room.view_en | jsonify }},
    "summary_vi": {{ room.summary_vi | jsonify }},
    "summary_en": {{ room.summary_en | jsonify }},
    "rate_low_vnd": {{ room.rate_low_vnd | jsonify }},
    "rate_dec_2026_vnd": {{ room.rate_dec_2026_vnd | jsonify }},
    "rate_jan_feb_2027_vnd": {{ room.rate_jan_feb_2027_vnd | jsonify }},
    "rate_holiday_tet_vnd": {{ room.rate_holiday_tet_vnd | jsonify }},
    "image": {% if room.images and room.images != empty %}{{ room.images | first | jsonify }}{% else %}null{% endif %},
    "object_position": {{ room.card_object_position | default: '50% 50%' | jsonify }}
  }{% unless forloop.last %},{% endunless %}
{% endfor %}
]
